/* ============================================================
   JANAVANI — REBUILD DESIGN SYSTEM
   STEP 2B
   STATUS: TEST / NOT YET LIVE
   ============================================================ */

/* ============================================================
   01. DESIGN TOKENS
   ============================================================ */

:root {
    --jv-navy-950: #071522;
    --jv-navy-900: #0b1d2a;
    --jv-navy-800: #102b3f;
    --jv-navy-700: #173b55;

    --jv-blue-600: #245b82;
    --jv-blue-100: #e9f1f6;

    --jv-gold-600: #c8892e;
    --jv-gold-500: #e2a746;
    --jv-gold-300: #f1cf8b;
    --jv-gold-100: #fbf3e2;

    --jv-ivory: #fbfaf7;
    --jv-white: #ffffff;

    --jv-text: #142638;
    --jv-text-soft: #526578;
    --jv-text-light: #edf4f8;

    --jv-border: rgba(16, 43, 63, 0.14);
    --jv-border-light: rgba(255, 255, 255, 0.18);

    --jv-success: #32735b;
    --jv-building: #9a6b20;
    --jv-future: #526b80;

    --jv-radius-sm: 8px;
    --jv-radius-md: 16px;
    --jv-radius-lg: 26px;
    --jv-radius-xl: 34px;

    --jv-shadow-sm:
        0 8px 24px rgba(7, 21, 34, 0.07);

    --jv-shadow-md:
        0 18px 50px rgba(7, 21, 34, 0.12);

    --jv-shadow-lg:
        0 30px 80px rgba(7, 21, 34, 0.18);

    --jv-container: 1240px;
    --jv-reading: 760px;

    --jv-space-1: 0.5rem;
    --jv-space-2: 0.75rem;
    --jv-space-3: 1rem;
    --jv-space-4: 1.5rem;
    --jv-space-5: 2rem;
    --jv-space-6: 3rem;
    --jv-space-7: 4rem;
    --jv-space-8: 6rem;
    --jv-space-9: 8rem;

    --jv-transition:
        180ms ease;
}


/* ============================================================
   02. RESET
   ============================================================ */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    min-width: 320px;

    background: var(--jv-ivory);
    color: var(--jv-text);

    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    font-size: 17px;
    line-height: 1.7;

    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

img,
svg {
    max-width: 100%;
    height: auto;
}

img {
    display: block;
}

a {
    color: inherit;
}

button,
input,
textarea,
select {
    font: inherit;
}


/* ============================================================
   03. ACCESSIBILITY
   ============================================================ */

:focus-visible {
    outline: 3px solid var(--jv-gold-500);
    outline-offset: 4px;
}

.skip-link {
    position: fixed;
    left: 1rem;
    top: -100px;
    z-index: 9999;

    padding: 0.75rem 1rem;

    background: var(--jv-white);
    color: var(--jv-navy-950);

    border-radius: var(--jv-radius-sm);
    box-shadow: var(--jv-shadow-md);
}

.skip-link:focus {
    top: 1rem;
}


/* ============================================================
   04. SHARED CONTAINER
   ============================================================ */

.jv-container {
    width: min(
        calc(100% - 3rem),
        var(--jv-container)
    );

    margin-inline: auto;
}

.jv-reading {
    max-width: var(--jv-reading);
}


/* ============================================================
   05. TYPOGRAPHY
   ============================================================ */

.jv-eyebrow {
    margin: 0 0 var(--jv-space-3);

    color: var(--jv-gold-600);

    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-transform: uppercase;
}

.jv-display {
    margin: 0;

    color: var(--jv-navy-950);

    font-size: clamp(
        3rem,
        7vw,
        6.8rem
    );

    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.94;
}

.jv-title {
    margin: 0;

    color: var(--jv-navy-900);

    font-size: clamp(
        2rem,
        4vw,
        4rem
    );

    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1.05;
}

.jv-lead {
    max-width: 760px;

    margin: var(--jv-space-4) 0 0;

    color: var(--jv-text-soft);

    font-size: clamp(
        1.08rem,
        2vw,
        1.35rem
    );

    line-height: 1.65;
}


/* ============================================================
   06. HEADER
   ============================================================ */

.jv-site-header {
    position: relative;
    z-index: 100;

    background: rgba(251, 250, 247, 0.94);

    border-bottom: 1px solid var(--jv-border);

    backdrop-filter: blur(18px);
}

.jv-header-inner {
    width: min(
        calc(100% - 3rem),
        var(--jv-container)
    );

    min-height: 82px;

    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--jv-space-5);
}

.jv-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;

    color: var(--jv-navy-900);

    font-weight: 800;
    text-decoration: none;
}

.jv-logo img {
    width: 48px;
    height: 48px;

    object-fit: contain;

    border-radius: 50%;
}

.jv-logo-wordmark {
    font-size: 1.1rem;
    letter-spacing: 0.04em;
}

.jv-navigation {
    display: flex;
    align-items: center;
    gap: 0.25rem;
}

.jv-navigation a {
    position: relative;

    padding: 0.65rem 0.8rem;

    color: var(--jv-navy-800);

    font-size: 0.95rem;
    font-weight: 700;

    text-decoration: none;

    border-radius: var(--jv-radius-sm);

    transition:
        color var(--jv-transition),
        background var(--jv-transition);
}

.jv-navigation a:hover,
.jv-navigation a[aria-current="page"] {
    color: var(--jv-gold-600);
    background: var(--jv-gold-100);
}

.jv-menu-toggle {
    display: none;

    padding: 0.65rem 0.9rem;

    border: 1px solid var(--jv-border);
    border-radius: var(--jv-radius-sm);

    background: var(--jv-white);
    color: var(--jv-navy-900);

    font-weight: 750;

    cursor: pointer;
}


/* ============================================================
   07. TRANSLATION
   ============================================================ */

.jv-language {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.gtranslate_wrapper {
    min-width: 110px;
}


/* ============================================================
   08. HERO — STANDARD
   ============================================================ */

.jv-hero {
    position: relative;

    min-height: 720px;

    display: flex;
    align-items: center;

    overflow: hidden;
}

.jv-hero-inner {
    position: relative;
    z-index: 2;

    width: min(
        calc(100% - 3rem),
        var(--jv-container)
    );

    margin-inline: auto;
}

.jv-hero-copy {
    max-width: 720px;
}

.jv-hero .jv-eyebrow {
    color: var(--jv-gold-500);
}

.jv-hero .jv-display {
    color: var(--jv-white);
}

.jv-hero .jv-lead {
    color: rgba(255, 255, 255, 0.88);
}


/* ============================================================
   09. HERO — FULL IMAGE
   IMPORTANT:
   Keep photographic image visible.
   Overlay is intentionally restrained.
   ============================================================ */

.jv-hero--image {
    background-image:
        linear-gradient(
            90deg,
            rgba(7, 21, 34, 0.76) 0%,
            rgba(7, 21, 34, 0.48) 32%,
            rgba(7, 21, 34, 0.14) 65%,
            rgba(7, 21, 34, 0.03) 100%
        ),
        url(
            "assets/images/janavani-home-hero-citizen-voice - webp.webp"
        );

    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
}

.jv-hero--image::after {
    content: "";

    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
        linear-gradient(
            180deg,
            rgba(7, 21, 34, 0.05),
            rgba(7, 21, 34, 0.10)
        );
}


/* ============================================================
   10. HERO CTA ROW
   ============================================================ */

.jv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;

    margin-top: var(--jv-space-6);
}

.jv-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;

    min-height: 52px;

    padding: 0.75rem 1.25rem;

    border: 1px solid transparent;
    border-radius: 999px;

    font-weight: 800;
    text-decoration: none;

    cursor: pointer;

    transition:
        transform var(--jv-transition),
        box-shadow var(--jv-transition),
        background var(--jv-transition);
}

.jv-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--jv-shadow-sm);
}

.jv-button--primary {
    background: var(--jv-gold-500);
    color: var(--jv-navy-950);
}

.jv-button--secondary {
    border-color: rgba(255, 255, 255, 0.72);

    background: transparent;
    color: var(--jv-white);
}

.jv-button--dark {
    background: var(--jv-navy-900);
    color: var(--jv-white);
}

.jv-button--light {
    background: var(--jv-white);
    color: var(--jv-navy-900);
}


/* ============================================================
   11. SECTION SYSTEM
   ============================================================ */

.jv-section {
    padding-block: var(--jv-space-9);
}

.jv-section--white {
    background: var(--jv-white);
}

.jv-section--soft {
    background: var(--jv-blue-100);
}

.jv-section--dark {
    background: var(--jv-navy-900);
    color: var(--jv-text-light);
}

.jv-section-heading {
    max-width: 850px;
    margin-bottom: var(--jv-space-7);
}

.jv-section-heading p:last-child {
    max-width: 760px;
}


/* ============================================================
   12. TWO-COLUMN EXPLANATION
   ============================================================ */

.jv-split {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

    gap: clamp(
        2rem,
        6vw,
        6rem
    );

    align-items: center;
}

.jv-split--wide {
    grid-template-columns:
        minmax(0, 1.1fr)
        minmax(0, 0.9fr);
}

.jv-split-media img {
    width: 100%;

    border-radius: var(--jv-radius-lg);

    box-shadow: var(--jv-shadow-md);
}


/* ============================================================
   13. INFORMATION CARDS
   ============================================================ */

.jv-card-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 1.25rem;
}

.jv-card {
    padding: var(--jv-space-5);

    background: var(--jv-white);

    border: 1px solid var(--jv-border);
    border-radius: var(--jv-radius-md);

    box-shadow: var(--jv-shadow-sm);
}

.jv-card h3 {
    margin-top: 0;

    color: var(--jv-navy-900);

    line-height: 1.2;
}

.jv-card p:last-child {
    margin-bottom: 0;
}


/* ============================================================
   14. PROCESS / CITIZEN JOURNEY
   ============================================================ */

.jv-process {
    display: grid;

    grid-template-columns:
        repeat(6, minmax(0, 1fr));

    gap: 0;
}

.jv-process-step {
    position: relative;

    padding: 1.25rem;

    border-top: 2px solid var(--jv-gold-500);
}

.jv-process-number {
    display: block;

    margin-bottom: 0.75rem;

    color: var(--jv-gold-600);

    font-size: 0.8rem;
    font-weight: 850;
    letter-spacing: 0.12em;
}

.jv-process-step h3 {
    margin: 0 0 0.5rem;

    color: var(--jv-navy-900);

    font-size: 1.05rem;
}


/* ============================================================
   15. STATUS SYSTEM
   ============================================================ */

.jv-status-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 1.25rem;
}

.jv-status {
    padding: var(--jv-space-5);

    border-radius: var(--jv-radius-md);

    background: var(--jv-white);

    border: 1px solid var(--jv-border);
}

.jv-status-label {
    display: inline-flex;

    margin-bottom: 1rem;

    padding: 0.35rem 0.7rem;

    border-radius: 999px;

    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.jv-status--now .jv-status-label {
    background: rgba(50, 115, 91, 0.12);
    color: var(--jv-success);
}

.jv-status--building .jv-status-label {
    background: rgba(154, 107, 32, 0.13);
    color: var(--jv-building);
}

.jv-status--future .jv-status-label {
    background: rgba(82, 107, 128, 0.13);
    color: var(--jv-future);
}


/* ============================================================
   16. IMAGE FRAME
   ============================================================ */

.jv-image-frame {
    overflow: hidden;

    border-radius: var(--jv-radius-lg);

    box-shadow: var(--jv-shadow-md);

    background: var(--jv-navy-900);
}

.jv-image-frame img {
    width: 100%;
    height: 100%;

    object-fit: cover;
}


/* ============================================================
   17. QUOTE / PRINCIPLE
   ============================================================ */

.jv-principle {
    padding: clamp(
        2rem,
        5vw,
        4rem
    );

    background: var(--jv-navy-900);

    border-radius: var(--jv-radius-xl);

    color: var(--jv-white);

    box-shadow: var(--jv-shadow-lg);
}

.jv-principle p {
    max-width: 900px;

    margin: 0;

    font-size: clamp(
        1.4rem,
        3vw,
        2.5rem
    );

    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
}


/* ============================================================
   18. SOCIAL LINKS
   ============================================================ */

.jv-social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
}

.jv-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 42px;
    min-height: 42px;

    padding: 0.55rem 0.8rem;

    border: 1px solid var(--jv-border);

    border-radius: 999px;

    color: var(--jv-navy-800);

    font-size: 0.85rem;
    font-weight: 750;

    text-decoration: none;

    transition:
        background var(--jv-transition),
        color var(--jv-transition);
}

.jv-social-link:hover {
    background: var(--jv-navy-900);
    color: var(--jv-white);
}


/* ============================================================
   19. FOOTER
   ============================================================ */

.jv-site-footer {
    padding-block: var(--jv-space-7);

    background: var(--jv-navy-950);
    color: rgba(255, 255, 255, 0.78);
}

.jv-footer-inner {
    width: min(
        calc(100% - 3rem),
        var(--jv-container)
    );

    margin-inline: auto;
}

.jv-footer-grid {
    display: grid;

    grid-template-columns:
        1.2fr
        1fr
        1fr;

    gap: var(--jv-space-6);
}

.jv-footer-brand {
    color: var(--jv-white);

    font-size: 1.2rem;
    font-weight: 800;
}

.jv-footer-navigation {
    display: grid;

    gap: 0.5rem;
}

.jv-footer-navigation a {
    color: rgba(255, 255, 255, 0.76);

    text-decoration: none;
}

.jv-footer-navigation a:hover {
    color: var(--jv-gold-500);
}

.jv-footer-bottom {
    margin-top: var(--jv-space-6);
    padding-top: var(--jv-space-4);

    border-top: 1px solid var(--jv-border-light);

    font-size: 0.85rem;
}


/* ============================================================
   20. BACK TO TOP
   ============================================================ */

.jv-scroll-top {
    position: fixed;

    right: 1.25rem;
    bottom: 1.25rem;

    z-index: 90;

    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;

    background: var(--jv-white);
    color: var(--jv-navy-900);

    box-shadow: var(--jv-shadow-md);

    cursor: pointer;
}


/* ============================================================
   21. DIVIDERS
   ============================================================ */

.jv-rule {
    height: 1px;

    margin-block: var(--jv-space-6);

    background: var(--jv-border);
}


/* ============================================================
   22. RESPONSIVE — TABLET
   ============================================================ */

@media (max-width: 1024px) {

    .jv-navigation {
        gap: 0;
    }

    .jv-navigation a {
        padding-inline: 0.55rem;
    }

    .jv-card-grid,
    .jv-status-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .jv-process {
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
    }

    .jv-footer-grid {
        grid-template-columns:
            1fr 1fr;
    }
}


/* ============================================================
   23. RESPONSIVE — MOBILE
   ============================================================ */

@media (max-width: 760px) {

    body {
        font-size: 16px;
    }

    .jv-container,
    .jv-header-inner,
    .jv-hero-inner,
    .jv-footer-inner {
        width: min(
            calc(100% - 2rem),
            var(--jv-container)
        );
    }

    .jv-site-header {
        position: sticky;
        top: 0;
    }

    .jv-header-inner {
        min-height: 70px;
    }

    .jv-menu-toggle {
        display: inline-flex;
    }

    .jv-navigation {
        display: none;

        position: absolute;

        left: 1rem;
        right: 1rem;
        top: calc(100% + 0.5rem);

        padding: 0.75rem;

        flex-direction: column;
        align-items: stretch;

        background: var(--jv-white);

        border: 1px solid var(--jv-border);
        border-radius: var(--jv-radius-md);

        box-shadow: var(--jv-shadow-md);
    }

    .jv-navigation.is-open {
        display: flex;
    }

    .jv-navigation a {
        width: 100%;
    }

    .jv-hero {
        min-height: 680px;
    }

    .jv-hero--image {
        background-position:
            58% center;

        background-image:
            linear-gradient(
                90deg,
                rgba(7, 21, 34, 0.76),
                rgba(7, 21, 34, 0.34)
            ),
            url(
                "assets/images/janavani-home-hero-citizen-voice - webp.webp"
            );
    }

    .jv-split,
    .jv-split--wide {
        grid-template-columns: 1fr;
    }

    .jv-card-grid,
    .jv-status-grid {
        grid-template-columns: 1fr;
    }

    .jv-process {
        grid-template-columns: 1fr;
    }

    .jv-process-step {
        border-top: 0;
        border-left: 2px solid var(--jv-gold-500);
    }

    .jv-footer-grid {
        grid-template-columns: 1fr;
    }

    .jv-section {
        padding-block: var(--jv-space-8);
    }
}


/* ============================================================
   24. SMALL MOBILE
   ============================================================ */

@media (max-width: 430px) {

    .jv-display {
        font-size: clamp(
            2.65rem,
            15vw,
            4rem
        );
    }

    .jv-title {
        font-size: 2rem;
    }

    .jv-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .jv-button {
        width: 100%;
    }
}


/* ============================================================
   25. REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }
}
/* ============================================================
   JANAVANI — SHARED SOCIAL INFRASTRUCTURE
   STEP 2D-2A-FIX
   Premium horizontal presentation
   ============================================================ */

.jv-social-links {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.25rem;
    width: 100%;
}

.jv-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;

    min-height: 2.5rem;
    padding: 0.55rem 0.8rem;

    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;

    color: rgba(255, 255, 255, 0.86);
    background: rgba(255, 255, 255, 0.035);

    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1;

    text-decoration: none;
    white-space: nowrap;

    transition:
        background-color 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        transform 180ms ease;
}

.jv-social-link img {
    display: block;

    width: 22px !important;
    height: 22px !important;

    min-width: 22px;
    min-height: 22px;

    max-width: 22px !important;
    max-height: 22px !important;

    object-fit: contain;
    object-position: center;

    flex: 0 0 22px;
}

.jv-social-link:hover,
.jv-social-link:focus-visible {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.28);
    transform: translateY(-1px);
}

.jv-social-link:focus-visible {
    outline: 2px solid #d59a35;
    outline-offset: 3px;
}

.jv-social-link--text {
    gap: 0.5rem;
}

.jv-social-monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 22px;
    height: 22px;

    flex: 0 0 22px;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;

    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1;
}

/* ------------------------------------------------------------
   CONTACT INFORMATION
   ------------------------------------------------------------ */

.jv-contact-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;

    margin-top: 1rem;

    font-size: 0.85rem;
}

.jv-contact-meta a {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
}

.jv-contact-meta a:hover,
.jv-contact-meta a:focus-visible {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 0.2em;
}

.jv-contact-separator {
    color: rgba(255, 255, 255, 0.32);
}

/* ------------------------------------------------------------
   FOOTER SOCIAL AREA
   ------------------------------------------------------------ */

.jv-site-footer .jv-social-links {
    max-width: 100%;
}

.jv-site-footer .jv-social-link span:last-child {
    color: inherit;
}

/* ------------------------------------------------------------
   RESPONSIVE
   ------------------------------------------------------------ */

@media (max-width: 700px) {

    .jv-social-links {
        gap: 0.5rem;
    }

    .jv-social-link {
        min-height: 2.35rem;
        padding: 0.5rem 0.7rem;
        font-size: 0.78rem;
    }

    .jv-social-link img,
    .jv-social-monogram {
        width: 20px !important;
        height: 20px !important;

        min-width: 20px;
        min-height: 20px;

        max-width: 20px !important;
        max-height: 20px !important;
    }

    .jv-contact-meta {
        font-size: 0.8rem;
    }
}

/* ------------------------------------------------------------
   REDUCED MOTION
   ------------------------------------------------------------ */

@media (prefers-reduced-motion: reduce) {

    .jv-social-link {
        transition: none;
    }

    .jv-social-link:hover {
        transform: none;
    }
}

